{
  "manifest_version": 3,
  "name": "Buildocrat Value Lens",
  "short_name": "Value Lens",
  "version": "1.1.0",
  "description": "Hover over Google Maps or OpenStreetMap anywhere in Nigeria to see land, building and rental values from the Buildocrat Land Value Book.",
  "homepage_url": "https://value.buildocrat.store/",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Buildocrat Value Lens", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "sw.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://value.buildocrat.store/*"],
  "content_scripts": [{
    "matches": ["https://www.google.com/maps*", "https://www.google.com.ng/maps*", "https://maps.google.com/*", "https://www.openstreetmap.org/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "commands": {
    "toggle-lens": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "Turn the value lens on or off" }
  }
}
